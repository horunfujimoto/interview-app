# backend/.env のテンプレート。コピーして値を埋める:
#   cp .env.example .env
# ※ .env は git 管理外（個人環境ごとの値・秘密情報を含むため）

# PostgreSQL 接続文字列（必須）
# 形式: postgresql://<ユーザー>:<パスワード>@<ホスト>:<ポート>/<DB名>
# DB名のデータベースは `npx prisma migrate dev` が自動作成する
DATABASE_URL="postgresql://postgres:0000@localhost:5432/interview_app"

# JWT 署名鍵（必須）。十分に長いランダム文字列を設定する
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# CORS で許可するフロントエンドのオリジン（未設定時: http://localhost:5173）
# FRONTEND_URL="http://localhost:5173"

# バックエンドの待受ポート（未設定時: 3001）
# PORT=3001

# リバースプロキシ（nginx / ALB 等）配下ではホップ数を設定する（例: 1）。
# 未設定のまま本番プロキシ配下に置くと req.ip がプロキシIPになり、
# レート制限の共有・監査ログのIP誤記録が起きる
# TRUST_PROXY=1

# 録画の保持日数（メンテナンスバッチが使用。未設定時: 180）
# RETENTION_DAYS=180

# ログレベル: fatal / error / warn / info / debug / trace（未設定時: info）
# LOG_LEVEL=info
